# Copy this file to .env and fill in your values
# NEVER commit your real .env file to GitHub

PORT=8000

# Get this from MongoDB Atlas (cloud) or use local MongoDB
# Cloud example: mongodb+srv://yourUsername:yourPassword@cluster0.xxxxx.mongodb.net/studytracker
# Local example: mongodb://localhost:27017/studytracker
MONGO_URI=your_mongodb_connection_string_here

# Make this a long random secret string — keep it private!
# Example: mysupersecretkey123abc (use something much longer in production)
JWT_SECRET=your_jwt_secret_key_here
